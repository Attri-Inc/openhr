# Path to the SQLite database (default: ./data/openhr.db)
OPENHR_DB=

# MCP transport:
#   stdio            Claude Desktop / Claude Code (they spawn the process)
#   streamable-http  remote clients, e.g. a Claude Cowork custom connector; served at /mcp
#   sse              the older HTTP transport, for existing clients
MCP_TRANSPORT=stdio

# Bind address for the HTTP transports (ignored for stdio).
# Loopback by default — read SECURITY.md before changing it.
MCP_HOST=127.0.0.1

# Port for the HTTP transports (ignored for stdio)
MCP_PORT=8792

# Public host names the HTTP transports accept, comma-separated. Needed behind a
# tunnel or reverse proxy, where the Host header is the public name and would
# otherwise be rejected with "Invalid Host header" (HTTP 421). Loopback is always
# allowed. Leave empty for a local-only server.
MCP_ALLOWED_HOSTS=

# Allowed Origin values, comma-separated. Defaults to https://<host> for each
# entry in MCP_ALLOWED_HOSTS.
MCP_ALLOWED_ORIGINS=
