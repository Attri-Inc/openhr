# Path to the SQLite database (default: ./data/openhr.db)
OPENHR_DB=

# MCP transport:
#   stdio            Claude Desktop / Claude Code (they spawn the process)
#   streamable-http  remote clients, e.g. a Claude Cowork custom connector; served at /mcp
#   sse              the older HTTP transport, for existing clients
MCP_TRANSPORT=stdio

# Bind address for the HTTP transports (ignored for stdio).
# Loopback by default — read SECURITY.md before changing it.
MCP_HOST=127.0.0.1

# Port for the HTTP transports (ignored for stdio)
MCP_PORT=8792
